{
  "name": "@repo/email",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./templates/*": "./src/templates/*.tsx"
  },
  "scripts": {
    "dev": "email dev --dir ./src/templates --port 3003",
    "export": "email export --dir ./src/templates --outDir ./dist",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@react-email/ui": "^6.9.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/jest-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.3",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.31.0",
    "jest": "^30.2.0",
    "react-email": "^6.9.0",
    "ts-jest": "^29.2.5",
    "typescript": "5.8.2"
  }
