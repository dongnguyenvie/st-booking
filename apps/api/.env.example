# Database
DATABASE_URL="postgresql://user:password@localhost:5432/carousel-marketplace?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_QUEUE_DB=2

# JWT
JWT_PRIVATE_
JWT_PUBLIC_

# App
PORT=7001
NODE_ENV=development
# APP_ENV controls app-level behavior independently of NODE_ENV.
# Values: local | development | staging | production
# Default: falls back to NODE_ENV if not set.
# Use case: NODE_ENV=production APP_ENV=staging → prod Node.js optimizations + staging services
APP_ENV=development
ORIGIN_DOMAIN=http://localhost:3000

AUTH0_DOMAIN=carousel-marketplace-core.jp.auth0.com
AUTH0_AUDIENCE=https://api.carousel-marketplace.com

AUTH0_M2M_CLIENT_ID=x7JrBemazle0GRCBDIgk02grzKkkyv1P
AUTH0_M2M_CLIENT_SECRET=gsvUskUrmREKxBbGx5b9WAt55ZKszNcZyLU3iz9Gy4VwIZs8DF1toeF9REQzkhTK


SEED_ON_START=true
BYPASS_AUTH=false

# Encryption
# base64-encoded 32-byte key for AES-256-GCM (TOTP secret encryption).
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Object storage (S3-compatible: AWS S3, MinIO, Cloudflare R2)
# Leave blank to run without storage — the app boots fine and only the first
# storage call fails, with a clear message.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
# Set only for non-AWS providers; forces path-style addressing when present.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=
# Presigned URL lifetime in seconds (default 900 = 15 min)
S3_PRESIGN_TTL_S=900