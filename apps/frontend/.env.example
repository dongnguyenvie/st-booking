# Auth0 SPA (PKCE flow) — no secret needed, public values only
NEXT_PUBLIC_AUTH0_DOMAIN=carousel-marketplace-core.jp.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=k7uXw6yY4tqj3d7EZPXsgXVp8B0VIsZi
NEXT_PUBLIC_AUTH0_AUDIENCE=https://api.carousel-marketplace.com

# SSL flag — set to "false" for local http, "true" (default) for https/wss
NEXT_PUBLIC_USE_SSL=false

# API endpoint (NestJS runs on port 7001)
NEXT_PUBLIC_API_ENDPOINT=localhost:7001
