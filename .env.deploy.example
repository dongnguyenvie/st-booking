# Docker Hub
DOCKER_HUB_USERNAME=your-dockerhub-username
TAG=latest

# Ports (host)
API_PORT=7001
FRONTEND_PORT=3000

# PostgreSQL
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=canmorestays
DATABASE_URL=postgresql://user:password@postgres:5432/canmorestays?schema=public

# Redis
REDIS_PASSWORD=
REDIS_DB=0
REDIS_QUEUE_DB=2

# JWT (base64-encoded PEM keys)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# App
ORIGIN_DOMAIN=http://localhost:3000

# Auth0 (server-side)
AUTH0_DOMAIN=canmorestays-core.jp.auth0.com
AUTH0_AUDIENCE=https://api.canmorestays.com
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=

# Auth0 (Next.js public build args)
NEXT_PUBLIC_AUTH0_DOMAIN=canmorestays-core.jp.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_AUDIENCE=https://api.canmorestays.com
NEXT_PUBLIC_USE_SSL=false
NEXT_PUBLIC_API_ENDPOINT=localhost:7001
